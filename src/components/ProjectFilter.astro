---
// ProjectFilter.astro - 项目列表的名字过滤 + 超过 5 条时的滚动预览
// 列表内容由页面传进来;过滤与高度判定在 scripts/filter.ts(无 JS 时列表照常显示)。
interface Props {
  count: number;
  placeholder?: string;
}
const { count, placeholder = 'Search projects by name…' } = Astro.props;
---

<div class="project-filter" data-project-filter>
  <div class="project-filter__bar">
    <span class="project-filter__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-4.3-4.3" /></svg>
    </span>
    <input
      class="project-filter__input"
      type="search"
      placeholder={placeholder}
      aria-label={placeholder}
      autocomplete="off"
      spellcheck="false"
    />
    <span class="project-filter__count" data-project-count aria-live="polite">{count}</span>
  </div>

  <div class="project-scroll" data-project-scroll>
    <div class="project-grid">
      <slot />
    </div>
  </div>

  <p class="project-filter__empty" data-project-empty hidden>No project matches that name.</p>
</div>