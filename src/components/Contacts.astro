---
// Contacts.astro - 联系方式列表
// 条目内容(标签 / 值 / 链接 / 色相 / 图标)全部来自 content/site.toml 的 [[contact]];
// 图标 SVG 在 src/data/content.ts 里按 icon 名登记,未登记的名字退回标签首字母。
import { CONTACTS } from '../data/content';
---

<nav class="rail-contacts" aria-label="联系方式">
  <div class="rail-label">Contact</div>
  <div class="contact-list">
    {
      CONTACTS.map((c) => (
        <a href={c.href} target="_blank" rel="noopener" class={`contact-item t-${c.hue}`}>
          <span class="contact-ico" aria-hidden="true" set:html={c.iconHtml} />
          <span class="contact-text">
            <span class="contact-label">{c.label}</span>
            <span class="contact-link">{c.value}</span>
          </span>
          <svg
            class="contact-arrow"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>
      ))
    }
  </div>
</nav>