---
// Nav.astro - 顶部导航条:五条链接 + 滑动指示条 + 主题拨钮
//
// float = true(默认):导航是悬浮在页面上的玻璃胶囊,外层 <liquid-glass> 负责玻璃面,
//   .nav-inner 自带一份 CSS 兜底玻璃,JS 未就绪 / 低配 / 老浏览器下就显示这一层。
// float = false(reader 页):沿用改造前的整条玻璃栏,结构一字未动。
import NavInner from './NavInner.astro';
import type { PageKey } from '../data/site';

interface Props {
  current: PageKey;
  /** 是否用浮动玻璃胶囊(reader 页传 false) */
  float?: boolean;
}
const { current, float = true } = Astro.props;
---

<header class:list={['site-nav', float && 'site-nav--float']}>
  {
    float ? (
      <liquid-glass class="nav-glass" radius={28} strength={5} blur={6} chroma={0.3}>
        <div class="ps-glass__content">
          <NavInner current={current} />
        </div>
      </liquid-glass>
    ) : (
      <NavInner current={current} />
    )
  }
</header>
