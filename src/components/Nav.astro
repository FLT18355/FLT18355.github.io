---
// Nav.astro - 顶部导航条:五条链接 + 滑动指示条 + 主题拨钮
//
// 一条贴顶的窄栏,没有胶囊、没有玻璃:导航是去找内容的地图,不是内容本身。
// reader 页与其余页面使用同一套结构(float 参数保留给页面调用方)。
import NavInner from './NavInner.astro';
import type { PageKey } from '../data/content';

interface Props {
  current: PageKey;
  /** 保留的页面开关:reader 页传 false,结构与默认相同 */
  float?: boolean;
}
const { current } = Astro.props;
---

<header class="site-nav site-nav--float">
  <div class="nav-glass">
    <NavInner current={current} />
  </div>
</header>
