---
// Glass.astro - 静态卡片的液态玻璃壳
// 正文通过 <slot /> 作为 children 进入 @vepando/liquid-glass-react 的 .lg__content。
import GlassCard from './GlassCard';

interface Props {
  /** 圆角(px) */
  radius?: number;
  /** 附加类:色相 b-xxx、布局类等 */
  class?: string;
}
const { radius = 14, class: cls = '' } = Astro.props;
---

<GlassCard client:load radius={radius} className={cls}>
  <slot />
</GlassCard>
