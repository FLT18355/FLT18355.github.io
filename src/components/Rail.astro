---
// Rail.astro - 左栏:身份卡 + 联系方式
//
// 身份卡套一层 <liquid-glass>:玻璃面画在外壳上,原 .profile 的内部结构
// (头像色环 / 渐变标题 / 顶部光晕 / 悬停扫光)一行没动。低配时外壳不升级,
// .profile 回到自己的 CSS 玻璃。
//
// 卡内的两样内容装饰都由 _editorial.scss 负责:
//   .profile-spec    底部的技术规格行(内容来自 content/site.toml 的 built_with)
//   .profile-rail    卡片底沿的一道品牌色收口
// 它们作为 .profile 的真实子元素插入(而不是伪元素),这样和正文同处玻璃的内容层,
// 不会被库生成的 surface / tint / rim 盖住。
import Contacts from './Contacts.astro';
import { SITE, PROFILE } from '../data/content';
---

<aside class="rail">
  <liquid-glass class="profile-glass" radius={14} strength={6} blur={7} chroma={0.4}>
    <div class="ps-glass__content">
      <div class="profile">
        <span class="avatar-ring">
          <img class="avatar-logo" src={PROFILE.avatar} alt={SITE.name} width="256" height="256" decoding="async" />
        </span>
        <h1>{SITE.name}</h1>
        <div class="handle">{SITE.handle}</div>
        <p class="tagline">{SITE.tagline}</p>
        <div class="profile-spec">
          {PROFILE.builtWith.map((item) => <span>{item}</span>)}
        </div>
        <span class="profile-rail" aria-hidden="true"></span>
      </div>
    </div>
  </liquid-glass>
  <Contacts />
</aside>
