---
// Rail.astro - 左栏:身份卡 + 联系方式
import Contacts from './Contacts.astro';
---

<aside class="rail">
  <div class="profile">
    <span class="avatar-ring">
      <!-- 旋转色环层:与 .avatar-ring 的静态 conic 底同色,motion-js 下绕中心缓转成流动色轮 -->
      <span class="avatar-halo" aria-hidden="true"></span>
      <img class="avatar-logo" src="/images/avatar.webp" alt="FLT18355" width="256" height="256" decoding="async" />
    </span>
    <h1>FLT18355</h1>
    <div class="handle">@FLT18355</div>
    <p class="tagline">Python. Arch. Catppuccin.</p>
    <!-- 浮雕瓦片组:呼应 banner 右侧的圆角方块(终端 / Catppuccin / 音乐),
         最末一块是虚线空瓦片,作为「待填」的纸面留白 -->
    <div class="profile-tiles" aria-hidden="true">
      <span class="profile-tile">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.2" y="5" width="17.6" height="13" rx="2.6"/><path d="m7.4 10 2.4 2-2.4 2"/><path d="M12.6 14h4"/></svg>
      </span>
      <span class="profile-tile">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.6 9.4 4.8 3.2l6 2.6"/><path d="M17.4 9.4l1.8-6.2-6 2.6"/><path d="M12 3.4c-4.6 0-7.8 3-7.8 7 0 4.4 3.3 7.2 7.8 7.2s7.8-2.8 7.8-7.2c0-4-3.2-7-7.8-7Z"/><circle cx="9.3" cy="11.2" r="1.1"/><circle cx="14.7" cy="11.2" r="1.1"/><path d="M12 13.4v2.2"/></svg>
      </span>
      <span class="profile-tile">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5.6l10-2v12.4"/><circle cx="6.4" cy="18" r="2.6"/><circle cx="16.4" cy="16" r="2.6"/></svg>
      </span>
      <span class="profile-tile profile-tile--ghost"></span>
    </div>
  </div>
  <Contacts />
</aside>
