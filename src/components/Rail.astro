---
// Rail.astro - 左栏:身份卡 + 联系方式
//
// 身份卡套一层 <liquid-glass>:玻璃面画在外壳上,原 .profile 的内部结构
// (头像色环 / 渐变标题 / 顶部光晕 / 悬停扫光)一行没动。低配时外壳不升级,
// .profile 回到自己的 CSS 玻璃。
//
// 除了色环头像与渐变名字,卡内还有三样「门面」装饰,都由 _editorial.scss 负责:
//   .profile-aurora  三枚极淡色晕,给卡片一个左上暖、右下冷的底
//   .profile-spec    底部 mono 事实行(本页由 Astro / Vue / SCSS 构成)
//   .profile-rail    卡片底沿的 14 色光谱轨,和页脚用同一条线
// 三样都作为 .profile 的真实子元素插入(而不是伪元素),这样和正文同处玻璃的内容层,
// 不会被库生成的 surface / tint / rim 盖住。
import Contacts from './Contacts.astro';
---

<aside class="rail">
  <liquid-glass class="profile-glass" radius={14} strength={6} blur={7} chroma={0.4}>
    <div class="ps-glass__content">
      <div class="profile">
        <span class="profile-aurora" aria-hidden="true"></span>
        <span class="avatar-ring">
          <!-- 旋转色环层:与 .avatar-ring 的静态 conic 底同色,motion-js 下绕中心缓转成流动色轮 -->
          <span class="avatar-halo" aria-hidden="true"></span>
          <img class="avatar-logo" src="/images/avatar.webp" alt="FLT18355" width="256" height="256" decoding="async" />
        </span>
        <h1>FLT18355</h1>
        <div class="handle">@FLT18355</div>
        <p class="tagline">Python. Arch. Catppuccin.</p>
        <div class="profile-spec">
          <span>Astro</span>
          <span>Vue</span>
          <span>SCSS</span>
        </div>
        <span class="profile-rail" aria-hidden="true"></span>
      </div>
    </div>
  </liquid-glass>
  <Contacts />
</aside>
