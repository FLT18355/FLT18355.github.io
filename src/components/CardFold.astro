---
// CardFold.astro - 可折叠卡片壳:卡片本身就是原生 <details>,标题行是 <summary>
// 默认展开(未折叠);折叠 / 展开由浏览器原生实现,无 JS 也能点标题收起。
// 状态记忆、右下角折叠坞、快捷键与深链展开见 src/scripts/fold.ts;样式见 src/styles/_fold.scss。
interface Props {
  /** 卡片标题(纯文本) */
  title: string;
  /** 页内唯一键:折叠状态持久化与深链(#id)都用它 */
  id?: string;
  /** 附加类:区块色相 b-xxx 等 */
  class?: string;
  /** 标题右侧的等宽小注(数量 / 单位) */
  note?: string;
  /** 摘要行补充信息(如 GitHub 卡的用户名 / 仓库数 / 关注数) */
  meta?: string[];
  /** 默认是否展开:全站默认未折叠 */
  open?: boolean;
}
const { title, id, class: cls = '', note, meta = [], open = true } = Astro.props;
---

<details class:list={['block', 'fold', 'card-fold', cls]} id={id} data-fold={id} open={open}>
  <summary class="block-header fold-head">
    <h2>{title}</h2>
    <span class="fold-tail">
      {meta.map((item) => <span class="fold-stat">{item}</span>)}
      {note && <span class="block-note">{note}</span>}
      <span class="fold-caret" aria-hidden="true"></span>
    </span>
  </summary>
  <div class="fold-body">
    <slot />
  </div>
</details>
