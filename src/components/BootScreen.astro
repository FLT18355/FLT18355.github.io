---
// BootScreen.astro - 启动界面(首启加载 / 回访过渡)
// 两个变体共用同一套标记结构(纸叠 + 封面卡):首启是「加载中」,回访是「欢迎回来 + Skip」,
// 所以两张卡长得像一对,只是内容与进度来源不同。
// 显隐由 <html> 上的 .boot-first / .boot-transition 决定:这两个类在 Base.astro 的
// head 内联脚本里同步写入(先于 body 解析,所以不会闪出一帧正文),逻辑在 src/scripts/boot.ts。
// 无 JS 时两个类都不存在,.boot 保持 display:none,页面照常可用。
// 启动层一律用系统字体渲染:此时字体选择还没发生(首启)或刚恢复,用 --ui-font 会在
// 选过 Maple 的机器上把 7.1MB 的 woff2 拖进首屏(与 _font-picker.scss 同一取舍)。
import { NAV } from '../data/site';
import type { PageKey } from '../data/site';

interface Props {
  /** 当前页键:回访卡片用它显示「即将进入哪一页」 */
  current: PageKey;
}

const { current } = Astro.props;
const here = NAV.find((item) => item.key === current);
---

<!-- 内联兜底层:即使主样式表还没到(或加载失败),启动层也能正确覆盖并锁住滚动 -->
<style is:inline>
  .boot { display: none; }
  html.boot-first { overflow: hidden; }
  html.boot-first .boot,
  html.boot-transition .boot {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 120;
  }
</style>

<div class="boot" id="boot">
  <!-- 变体 A 首启:先把网页内容加载完,再整层淡出交给字体向导 -->
  <div class="boot__first">
    <div class="boot__stack">
      <div class="boot__card">
        <!-- 头像环走 CSS background(不是 <img>):两张卡共用同一段标记,主题换图也留在 CSS 里 -->
        <span class="boot__mark" aria-hidden="true"></span>
        <p class="boot__wordmark">FLT18355</p>
        <p class="boot__title">Preparing your page</p>
        <p class="boot__sub">Page content loads first, then the font wizard.</p>
        <span class="boot__rail" id="bootRail" aria-hidden="true">
          <i class="boot__rail-fill" id="bootRailFill"></i>
        </span>
        <p class="boot__meta">
          <span class="boot__status" id="bootStatus" role="status">Loading page</span>
          <span class="boot__pct" id="bootPct" aria-hidden="true">0%</span>
        </p>
      </div>
    </div>
  </div>

  <!-- 变体 B 回访:同一张封面卡,多一条自己走满的进度轨和一个 Skip。
       点 / 触 / 滚 / 按键也都能立刻跳过,不按会自己走完 -->
  <div class="boot__cover">
    <div class="boot__stack">
      <div class="boot__card">
        <span class="boot__mark" aria-hidden="true"></span>
        <p class="boot__wordmark">FLT18355</p>
        <p class="boot__title">Welcome back</p>
        <p class="boot__sub">Your theme and font choice are remembered.</p>
        <span class="boot__rail" aria-hidden="true">
          <i class="boot__rail-fill" id="bootCoverFill"></i>
        </span>
        <p class="boot__meta">
          <span class="boot__status">Entering</span>
          <span class="boot__pct boot__pct--label">{here ? here.label : ''}</span>
        </p>
        <button class="boot__skip" id="bootSkip" type="button">Skip</button>
      </div>
    </div>
  </div>
</div>
