---
// index.astro - 首页:关于 / 兴趣 / 技术栈 / 音乐 / 天气
import Base from '../layouts/Base.astro';
import CardFold from '../components/CardFold.astro';
import MusicPlayer from '../components/MusicPlayer.vue';
import StatsCounter from '../components/StatsCounter.vue';
import WeatherWidget from '../components/WeatherWidget.vue';
---

<Base
  title="FLT18355 - Home"
  description="FLT18355 的个人主页。Catppuccin 爱好者,Python、Arch、终端与 TUI 工具。"
  current="home"
>
  <CardFold id="b-about" class="b-about" title="About Me">
    <p class="about-lead">
      A <strong>Catppuccin</strong> enjoyer. Python user tinkering with dotfiles and TUI tools on
      Arch Linux.
    </p>
    <div class="flavors" role="img" aria-label="Catppuccin 四种风味">
      <span class="flavor f-mocha"><i></i>Mocha</span>
      <span class="flavor f-latte"><i></i>Latte</span>
      <span class="flavor f-frappe"><i></i>Frappé</span>
      <span class="flavor f-macchiato"><i></i>Macchiato</span>
    </div>
  </CardFold>

  <CardFold id="b-interests" class="b-interests" title="Interests">
    <div class="interest-list">
      <span class="interest">Terminal &amp; dotfiles</span>
      <span class="interest">Catppuccin theming</span>
      <span class="interest">Music</span>
      <span class="interest">Open source</span>
      <span class="interest">TUI tools</span>
      <span class="interest">Vibe coding</span>
    </div>
  </CardFold>

  <CardFold id="b-tech" class="b-tech" title="Tech Stack">
    <div class="tech-grid">
      <span class="tech-tag main t-blue tech-tag--icon">
        <span class="tech-ico" aria-hidden="true">
          <img class="tech-ico-mocha" src="/images/svg/python.svg" alt="" width="16" height="16" loading="lazy" />
          <img class="tech-ico-latte" src="/images/svg/python_l.svg" alt="" width="16" height="16" loading="lazy" />
        </span>
        Python
      </span>
      <span class="tech-tag main t-teal tech-tag--icon">
        <span class="tech-ico" aria-hidden="true">
          <img class="tech-ico-mocha" src="/images/svg/typescript.svg" alt="" width="16" height="16" loading="lazy" />
          <img class="tech-ico-latte" src="/images/svg/typescript_l.svg" alt="" width="16" height="16" loading="lazy" />
        </span>
        TypeScript
      </span>
      <span class="tech-tag t-green">Node.js</span>
      <span class="tech-tag t-pink">Shell</span>
      <span class="tech-tag t-peach">HTML</span>
      <span class="tech-tag t-mauve">Lua</span>
    </div>
  </CardFold>

  <CardFold id="b-stats" class="b-stats" title="By the Numbers">
    <StatsCounter client:load />
  </CardFold>

  <MusicPlayer client:load />

  <WeatherWidget client:load />
</Base>
