---
// index.astro - 首页:关于 / 统计 / 技术栈 / 兴趣 / 音乐 / 天气(≥1120px 走 bento 网格)
// 文案与筹码全部来自 content/site.toml,这里只负责排版。
import Base from '../layouts/Base.astro';
import CardFold from '../components/CardFold.astro';
import MusicPlayer from '../components/MusicPlayer.vue';
import StatsCounter from '../components/StatsCounter.vue';
import WeatherWidget from '../components/WeatherWidget.vue';
import { PROFILE, TECH, INTERESTS } from '../data/content';

/** 风味色相:与 _cards.scss 的 .f-<name> 一致 */
const FLAVOR_CLASS: Record<string, string> = {
  Mocha: 'f-mocha',
  Latte: 'f-latte',
  'Frappé': 'f-frappe',
  Macchiato: 'f-macchiato',
};
---

<Base
  title="FLT18355 - Home"
  description="FLT18355 的个人主页。Catppuccin 爱好者,Python、Arch、终端与 TUI 工具。"
  current="home"
  contentClass="content--bento"
>
  <CardFold id="b-about" class="b-about" title="About Me">
    <p class="about-lead" set:html={PROFILE.about}></p>
    <div class="flavors" role="img" aria-label="Catppuccin 四种风味">
      {
        PROFILE.flavors.map((name) => (
          <span class:list={['flavor', FLAVOR_CLASS[name]]}>
            <i />
            {name}
          </span>
        ))
      }
    </div>
  </CardFold>

  <CardFold id="b-stats" class="b-stats" title="By the Numbers">
    <StatsCounter client:load />
  </CardFold>

  <CardFold id="b-tech" class="b-tech" title="Tech Stack">
    <div class="tech-grid">
      {
        TECH.map((t) => (
          <span class:list={['tech-tag', t.icon && 'tech-tag--icon', `t-${t.hue}`]}>
            {t.icon && (
              <span class="tech-ico" aria-hidden="true">
                <img class="tech-ico-mocha" src={`/images/svg/${t.icon}.svg`} alt="" width="16" height="16" loading="lazy" />
                <img class="tech-ico-latte" src={`/images/svg/${t.icon}_l.svg`} alt="" width="16" height="16" loading="lazy" />
              </span>
            )}
            {t.name}
          </span>
        ))
      }
    </div>
  </CardFold>

  <CardFold id="b-interests" class="b-interests" title="Interests">
    <div class="interest-list">
      {INTERESTS.map((i) => <span class="interest" set:html={i.name} />)}
    </div>
  </CardFold>

  <MusicPlayer client:load />

  <WeatherWidget client:load />
</Base>