---
// catppuccin.astro - Catppuccin 色板页
import Base from '../layouts/Base.astro';
import CardFold from '../components/CardFold.astro';
import PaletteGrid from '../components/PaletteGrid.vue';
import { FLAVORS } from '../data/palette';
---

<Base
  title="FLT18355 - Palette"
  description="Catppuccin full palette: 4 flavors × 26 colors, click a swatch to copy the CSS variable."
  current="palette"
>
  <CardFold id="b-palette" class="b-palette" title="Catppuccin Palette">
    <p class="about-lead">4 flavors × 26 colors, <strong>click a swatch</strong> to copy the CSS variable name.</p>

    <div class="palette-preview">
      <h3 class="palette-preview-title">Live Preview</h3>
      <p class="palette-preview-note">Tracks the current site theme (Mocha / Latte). Try the toggle in the top-right corner.</p>
      <div class="preview-card">
        <div class="preview-top">
          <span class="preview-avatar" aria-hidden="true"></span>
          <div>
            <div class="preview-name">FLT18355</div>
            <div class="preview-sub">@FLT18355</div>
          </div>
        </div>
        <p class="preview-text">
          A card preview under the Catppuccin theme: buttons, inputs and tags all render with the site tokens.
        </p>
        <div class="preview-actions">
          <button type="button" class="preview-btn">Primary</button>
          <button type="button" class="preview-btn preview-btn--ghost">Ghost</button>
        </div>
        <div class="preview-input" role="img" aria-label="Input preview">Search...</div>
        <div class="preview-tags">
          <span class="preview-tag">Python</span>
          <span class="preview-tag preview-tag--mauve">Lua</span>
          <span class="preview-tag preview-tag--teal">TypeScript</span>
        </div>
      </div>
    </div>

    <div class="palette-compare">
      <h3 class="palette-compare-title">Flavor Compare</h3>
      <p class="palette-compare-note">The same colors across the 4 flavors side by side, so the lightness differences are obvious at a glance.</p>
      <div class="compare-rows">
        <div class="compare-head" aria-hidden="true">
          <span class="compare-name"></span>
          <div class="compare-bars">
            {FLAVORS.map((f) => <span class="compare-flavor">{f.name}</span>)}
          </div>
        </div>
        {['Red', 'Green', 'Blue', 'Mauve', 'Base', 'Surface 1'].map((c) => (
          <div class="compare-row">
            <span class="compare-name">{c}</span>
            <div class="compare-bars">
              {FLAVORS.map((f) => (
                <span class="compare-cell" title={`${f.name} ${c} ${f.hex[c]}`}>
                  <span class="compare-bar" style={`background: ${f.hex[c]};`}></span>
                  <span class="compare-hex">{f.hex[c]}</span>
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <PaletteGrid client:load />
  </CardFold>
</Base>
