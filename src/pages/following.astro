---
// following.astro - 关注项目
import Base from '../layouts/Base.astro';
import CardFold from '../components/CardFold.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Leaderboard from '../components/Leaderboard.vue';
import { followingProjects } from '../data/projects';
---

<Base
  title="FLT18355 - Following"
  description="FLT18355 正在关注的项目:herdr / oh-my-pi / catppuccin / neovim。"
  current="following"
>
  <CardFold id="b-following" class="b-following" title="Recently Following">
    <div class="project-grid">
      {followingProjects.map((p) => <ProjectCard project={p} />)}
    </div>
  </CardFold>

  <Leaderboard client:load />
</Base>
