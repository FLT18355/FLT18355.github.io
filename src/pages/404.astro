---
// 404.astro - 独立错误页(不挂导航壳,只带主题/字体恢复与全局令牌)
import '../styles/global.scss';
/* liquid-glass 的 chrome 装饰层样式(固定部分);挂载闸门见 scripts/glass.ts */
import '@liquidglassjs/core/css';
import HeadPrefs from '../components/HeadPrefs.astro';
import { SITE } from '../data/site';
---

<!DOCTYPE html>
<html lang="zh-CN" data-theme="mocha">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="404 - Page not found" />
    <!-- 主题 / 字体 / 渲染档位:与全站共用同一份 head 内联脚本(theme-color 也在里面)。
         这里原先自己写了一套,主题判定用的是 prefers-color-scheme,和全站的本机时间默认值
         对不上,同一个访客在两处会看到不同主题;合并后这个漂移不会再发生。 -->
    <HeadPrefs />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content="404 - FLT18355" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>404 - FLT18355</title>

    <style>
      .err404 {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        position: relative;
        z-index: 1;
      }
      /* 地址栏收起时 100vh 会跳;dvh 才是稳定视口高度。兜底走 @supports,
         就地写两行会被 CSS 压缩器当冗余删掉前一条。 */
      @supports (height: 100dvh) {
        .err404 {
          min-height: 100dvh;
        }
      }
      .err404-card {
        max-width: 400px;
        text-align: center;
      }
      .err404-cat {
        width: 64px;
        height: 64px;
        color: var(--mauve);
        margin: 0 auto 16px;
      }
      .err404-code {
        font-family: var(--mono);
        font-size: 2.6rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
        /* 与 rail 标题同款渐变裁字 */
        background: var(--grad-brand);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
      }
      .err404-card p {
        margin-top: 10px;
        font-size: 0.9rem;
      }
      .err404-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 20px;
        padding: 10px 20px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--primary) 45%, transparent);
        background: var(--primary-dim);
        color: var(--primary);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: border-color 0.15s, color 0.15s, transform 0.15s var(--ease-out), box-shadow 0.15s;
      }
      .err404-back:hover {
        border-color: var(--primary);
        transform: translateY(-2px);
        box-shadow: var(--shadow);
      }
      .err404-back:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
      }
      .err404-paws {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin-bottom: 14px;
        color: var(--sky);
        opacity: 0.55;
      }
      .err404-search {
        display: flex;
        gap: 8px;
        margin: 16px auto 0;
        max-width: 280px;
        padding: 6px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--primary) 40%, transparent);
        background: var(--primary-dim);
      }
      .err404-search-input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        background: transparent;
        color: var(--text);
        font-size: 0.85rem;
        padding: 7px 10px 7px 12px;
      }
      .err404-search-input::placeholder { color: var(--text-muted); }
      .err404-search-go {
        flex-shrink: 0;
        border: none;
        border-radius: 999px;
        padding: 7px 16px;
        background: var(--primary);
        color: var(--bg);
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s, transform 0.15s var(--ease-out);
      }
      .err404-search-go:hover { background: var(--primary-hover); }
      .err404-search-go:active { transform: scale(0.96); }
      .err404-search-go:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

      /* ---------- 动效:卡片入场 + 小猫浮动 + 爪印起伏 ----------
         本页样式内联,动效也放在这里,自包含、不牵连全局层;
         低配(html.lite)与系统「减弱动效」各自熄火。 */
      @keyframes err404In {
        from { opacity: 0; transform: translateY(16px) scale(0.98); }
        to   { opacity: 1; transform: none; }
      }
      .err404-card {
        animation: err404In 0.6s cubic-bezier(0.23, 1, 0.32, 1) both;
      }
      @keyframes err404Bob {
        0%, 100% { transform: translateY(0) rotate(-2deg); }
        50%      { transform: translateY(-6px) rotate(2deg); }
      }
      .err404-cat {
        animation: err404Bob 4.5s ease-in-out infinite;
      }
      @keyframes err404Paw {
        0%, 100% { transform: translateY(0) scale(1); }
        50%      { transform: translateY(-4px) scale(1.08); }
      }
      .err404-paws svg {
        animation: err404Paw 2.4s ease-in-out infinite;
      }
      .err404-paws svg:nth-child(2) { animation-delay: 0.25s; }
      .err404-paws svg:nth-child(3) { animation-delay: 0.5s; }
      html.lite .err404-card,
      html.lite .err404-cat,
      html.lite .err404-paws svg {
        animation: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .err404-card,
        .err404-cat,
        .err404-paws svg {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>

    <div class="err404">
      <!-- 玻璃外壳:错误卡本体(.font-picker-card)在低配 / 无 JS 时仍是自己的 CSS 玻璃 -->
      <liquid-glass class="err404-glass" radius={14} strength={6} blur={6} chroma={0.35}>
        <div class="ps-glass__content">
          <div class="font-picker-card err404-card">
            <div class="err404-paws" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><ellipse cx="6" cy="9" rx="2.2" ry="2.8"/><ellipse cx="12" cy="6.5" rx="2.4" ry="3"/><ellipse cx="18" cy="9" rx="2.2" ry="2.8"/><path d="M12 11c-3 0-5 2-5 4.5S9 20 12 20s5-2 5-4.5S15 11 12 11z"/></svg>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><ellipse cx="6" cy="9" rx="2.2" ry="2.8"/><ellipse cx="12" cy="6.5" rx="2.4" ry="3"/><ellipse cx="18" cy="9" rx="2.2" ry="2.8"/><path d="M12 11c-3 0-5 2-5 4.5S9 20 12 20s5-2 5-4.5S15 11 12 11z"/></svg>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><ellipse cx="6" cy="9" rx="2.2" ry="2.8"/><ellipse cx="12" cy="6.5" rx="2.4" ry="3"/><ellipse cx="18" cy="9" rx="2.2" ry="2.8"/><path d="M12 11c-3 0-5 2-5 4.5S9 20 12 20s5-2 5-4.5S15 11 12 11z"/></svg>
            </div>
            <svg
              class="err404-cat"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            ><path d="M6.6 9.4 4.8 3.2l6 2.6" /><path d="M17.4 9.4l1.8-6.2-6 2.6" /><path d="M12 3.4c-4.6 0-7.8 3-7.8 7 0 4.4 3.3 7.2 7.8 7.2s7.8-2.8 7.8-7.2c0-4-3.2-7-7.8-7Z" /><circle cx="9.3" cy="11.2" r="1.1" /><circle cx="14.7" cy="11.2" r="1.1" /><path d="M12 13.4v2.2" /></svg>
            <div class="err404-code">404</div>
            <p id="err404Msg">This page is missing or moved.</p>
            <form class="err404-search" action="https://www.bing.com/search" method="get" target="_blank" rel="noopener" role="search">
              <input class="err404-search-input" type="search" name="q" placeholder="Search..." aria-label="Search the site" autocomplete="off" spellcheck="false" />
              <button class="err404-search-go" type="submit">Search</button>
            </form>
            <a class="err404-back" href="/index.html">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
              Back to Home
            </a>
          </div>
        </div>
      </liquid-glass>
    </div>
    <script>
      /* liquid-glass 挂载闸门:低配 / 减弱透明度 / 老浏览器直接跳过,错误卡保持 CSS 玻璃 */
      import '../scripts/glass.ts';
    </script>
    <script>
      (function () {
        var msgs = [
          "This page is missing or moved.",
          "Nothing here. Try searching instead?",
          "Well, this is awkward...",
          "404: the page wandered off.",
          "Nope, nothing found here. Try the search box above."
        ];
        var el = document.getElementById('err404Msg');
        if (el) el.textContent = msgs[Math.floor(Math.random() * msgs.length)];
      })();
    </script>
  </body>
</html>
