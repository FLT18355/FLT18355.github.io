---
// projects.astro - 重点项目 + 其他站点 + GitHub 资料卡(构建时从 api.github.com 拉取)
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SiteCard from '../components/SiteCard.astro';
import GithubCard from '../components/GithubCard.astro';
import { featuredProjects, otherSites } from '../data/projects';
import { getGithubUser } from '../data/github';

const githubUser = await getGithubUser();

/** GitHub 资料卡折叠时摘要行里的数字,与卡内统计块同源(同一份 data/github.ts 数据) */
const ghSummary = githubUser
  ? [
      `@${githubUser.login}`,
      `${githubUser.publicRepos} repos`,
      `${githubUser.followers} followers`,
    ]
  : [];
---

<Base
  title="FLT18355 - Projects"
  description="FLT18355 的重点项目:终端配置、OpenTUI 音乐播放器 lxm、dotfiles,以及其他站点与 GitHub 资料卡。"
  current="projects"
>
  <section class="block b-projects">
    <div class="block-header">
      <h2>Featured Projects</h2>
      <span class="block-note">{featuredProjects.length} repositories</span>
    </div>
    <div class="project-grid">
      {featuredProjects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  {
    otherSites.length > 0 && (
      <section class="block b-sites">
        <div class="block-header">
          <h2>Other Websites</h2>
          <span class="block-note">{otherSites.length} site{otherSites.length > 1 ? 's' : ''}</span>
        </div>
        <div class="site-list">
          {otherSites.map((s) => (
            <SiteCard site={s} />
          ))}
        </div>
      </section>
    )
  }

  {
    githubUser && (
      <section class="block b-github">
        <details class="fold">
          <summary class="block-header fold-head">
            <h2>GitHub Profile</h2>
            <span class="fold-tail">
              {ghSummary.map((item) => (
                <span class="fold-stat">{item}</span>
              ))}
              <span class="fold-caret" aria-hidden="true" />
            </span>
          </summary>
          <div class="fold-body">
            <GithubCard user={githubUser} />
          </div>
        </details>
      </section>
    )
  }

  <section class="block b-download">
    <div class="block-header">
      <h2>Download</h2>
    </div>
    <a
      class="download-card"
      href="https://v4.gh-proxy.org/https://github.com/FLT18355/dsh-pet-inAndroid/releases/download/1.0.1/app-release.apk"
      target="_blank"
      rel="noopener"
    >
      <span class="download-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 5-5m-5 5-5-5"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
      </span>
      <span class="download-info">
        <span class="download-title">app-release.apk</span>
        <span class="download-sub">dsh-pet-inAndroid · v1.0.1</span>
      </span>
      <span class="download-go">Download</span>
    </a>
  </section>
</Base>
