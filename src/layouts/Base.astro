---
// Base.astro - 全站骨架:head 元信息 + 主题/字体恢复内联脚本 + 导航 + 两栏壳
import '../styles/global.scss';
/* liquid-glass 的 chrome 三个装饰层样式(固定部分,随页面样式一起下发)。
   挂载闸门在 scripts/glass.ts,低配 / 老浏览器下不会引入任何玻璃 JS。 */
import '@liquidglassjs/core/css';
import Nav from '../components/Nav.astro';
import Rail from '../components/Rail.astro';
import Footline from '../components/Footline.astro';
import BootScreen from '../components/BootScreen.astro';
import FontPicker from '../components/FontPicker.vue';
import { SITE } from '../data/site';
import type { PageKey } from '../data/site';

interface Props {
  title: string;
  description: string;
  current: PageKey;
  /** false 时去掉左栏并居中限宽(search 页) */
  rail?: boolean;
  /** 仅在 rail=false 时有效:去掉限宽,让内容占满 shell 宽度(reader 页) */
  wide?: boolean;
  /** 内容列附加类:首页传 content--bento 切成 12 栏 bento 网格 */
  contentClass?: string;
  /** 是否使用浮动玻璃胶囊导航:reader 页传 false,保持改造前的整条玻璃栏 */
  glassNav?: boolean;
}

const { title, description, current, rail = true, wide = false, contentClass = '', glassNav = true } = Astro.props;

const ldJson = JSON.stringify(
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'FLT18355',
    url: 'https://flt18355.github.io/',
    sameAs: ['https://github.com/FLT18355', 'https://space.bilibili.com/517296410'],
  },
  null,
  2
);
---

<!DOCTYPE html>
<html lang="zh-CN" data-theme="mocha">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content={SITE.themeColorMocha}
      data-color-mocha={SITE.themeColorMocha}
      data-color-latte={SITE.themeColorLatte}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE.url} />
    <meta property="og:image" content={SITE.ogImage} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={ldJson}></script>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>{title}</title>

    <!-- 主题恢复:head 内执行,防主题闪烁。
         没手动选过时按本机时间给默认值:白天(07:00-18:59)Latte,其余时间 Mocha。
         拨钮切换会写 localStorage 的 theme,之后一律以用户自己的选择为准,不再看时间。
         ?theme=latte / ?theme=mocha 可临时覆盖本次加载(不写 localStorage),用来对比两支。
         顺带把浏览器界面色(地址栏 / 状态栏)对齐到同一个主题,
         否则白天默认 Latte 而 meta 还是深色,手机上手最显眼的就是这一条。 -->
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {
          /* 隐私模式读不到:按未选择处理 */
        }
        if (t !== 'latte' && t !== 'mocha') {
          var h = new Date().getHours();
          t = h >= 7 && h < 19 ? 'latte' : 'mocha';
        }
        try {
          var forced = new URLSearchParams(location.search).get('theme');
          if (forced === 'latte' || forced === 'mocha') t = forced;
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          var c = meta.getAttribute(t === 'latte' ? 'data-color-latte' : 'data-color-mocha');
          if (c) meta.setAttribute('content', c);
        }
      })();
    </script>
    <!-- 字体选择:恢复已存选择,避免字体闪烁(选择界面显隐由 FontPicker.vue 处理) -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var f = localStorage.getItem('site-font');
          if (f === 'default' || f === 'maple') root.setAttribute('data-font', f);
        } catch (e) {}
      })();
    </script>
    <!-- 渲染档位:low(低配)/ high(高配)/ max(全特效)。
         必须在 head 内同步执行,否则玻璃 / 高频背景 / 光斑会先渲染一帧再切掉。
         优先级:?mode= > ?lite= > localStorage.site-mode > localStorage.site-lite(旧键)> 自动判定。
         自动判定只在 low / high 之间选:max 是纯手动的,免得弱机被光效拖死。
         ?lite=1/0 仍然可用(等价于 low / high),方便老书签与快速对比。 -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var mode = null;
        try {
          var q = new URLSearchParams(location.search);
          var qm = q.get('mode');
          var ql = q.get('lite');
          if (qm === 'low' || qm === 'high' || qm === 'max') {
            mode = qm;
            localStorage.setItem('site-mode', mode);
          } else if (ql === '1' || ql === '0') {
            mode = ql === '1' ? 'low' : 'high';
            localStorage.setItem('site-mode', mode);
          } else {
            mode = localStorage.getItem('site-mode');
            if (mode !== 'low' && mode !== 'high' && mode !== 'max') {
              var legacy = localStorage.getItem('site-lite');
              mode = legacy === 'on' ? 'low' : legacy === 'off' ? 'high' : null;
            }
          }
        } catch (e) {}
        if (!mode) {
          var nav = navigator;
          var conn = nav.connection || nav.mozConnection || nav.webkitConnection;
          var mem = nav.deviceMemory;
          var cores = nav.hardwareConcurrency || 0;
          var coarse = false;
          try {
            coarse = window.matchMedia('(pointer: coarse)').matches;
          } catch (e) {}
          var weak =
            !!(conn && conn.saveData) ||
            (typeof mem === 'number' && mem <= 4) ||
            (coarse && cores > 0 && cores <= 4);
          mode = weak ? 'low' : 'high';
        }
        /* data-mode 供页脚档位开关读取与显示(CSS 只认它,所以关掉 JS 时开关整块不渲染);
           html.lite 只有 low 档才挂,后面的精简层与玻璃挂载闸门都读它 */
        root.setAttribute('data-mode', mode);
        if (mode === 'low') root.className += ' lite';
      })();
    </script>
    <!-- 启动界面显隐:与主题 / 字体 / 低配同一原则,类必须在 head 内同步写入,
         否则会先闪出一帧正文再盖上启动层。
         首启(localStorage 里还没有 site-font)= 加载层,加载完进字体向导;
         其余时候 = 过渡层,每个会话只走一次(sessionStorage 的 boot-seen),可以直接跳过。
         手动覆盖:?boot=0 关掉,?boot=1 强制过渡,?boot=first 强制首启。 -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var forced = null;
        try {
          forced = new URLSearchParams(location.search).get('boot');
        } catch (e) {}
        if (forced === '0' || forced === 'off') return;
        var first = false;
        var seen = false;
        try {
          var f = localStorage.getItem('site-font');
          first = !(f === 'default' || f === 'maple');
          seen = sessionStorage.getItem('boot-seen') === '1';
        } catch (e) {
          /* 隐私模式读不到:按未选择处理,至少不影响首启引导 */
          first = true;
        }
        var mode = '';
        if (forced === 'first') mode = 'first';
        else if (forced === '1' || forced === 'transition') mode = 'transition';
        else if (first) mode = 'first';
        else if (!seen) mode = 'transition';
        if (!mode) return;
        root.className += mode === 'first' ? ' boot-first' : ' boot-transition';
      })();
    </script>
  </head>
  <body>
    <!-- 启动界面(首启加载 / 回访过渡):固定层压在最上面,显隐由 html 上的
         .boot-first / .boot-transition 决定,两个类已在 head 内联脚本里写好 -->
    <BootScreen current={current} />

    <!-- 背景纸层(纯装饰,aria-hidden):分层纸面 + 点阵 + 等高线 + 虚线瓦片 + 节点连线。
         参照 demo/readme-banner.webp 右侧的纸质浮雕语言;低配层在 _lite.scss 里整块关掉。 -->
    <div class="bg-art" aria-hidden="true">
      <span class="bg-art__sheets"><i></i><i></i><i></i></span>
      <span class="bg-art__dots"></span>
      <span class="bg-art__contour"></span>
      <!-- 高频层:只在 max 档显示,给位移贴图提供「有边可弯」的结构(见 _paper.scss 第 4 节) -->
      <span class="bg-art__grid"></span>
      <span class="bg-art__neon"></span>
      <span class="bg-art__tile"></span>
      <svg class="bg-art__nodes" viewBox="0 0 420 220" fill="none">
        <path d="M10 186C104 186 118 30 214 30c96 0 108 138 196 138" />
        <circle cx="10" cy="186" r="3.5" />
        <circle cx="214" cy="30" r="3.5" />
        <circle cx="410" cy="168" r="3.5" />
      </svg>
    </div>

    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>

    <FontPicker client:load />

    <Nav current={current} float={glassNav} />

    <div class:list={['shell', !rail && 'shell--bare', !rail && wide && 'shell--wide']}>
      {rail && <Rail />}
      <!-- ============ Right column: content ============ -->
      <main class:list={['content', contentClass]}>
        <slot />

        <Footline />
      </main>
    </div>

    <slot name="body-end" />

    <script>
      import '../scripts/motion.ts';
      import '../scripts/nav.ts';
      import '../scripts/fold.ts';
      /* 必须排在 fold.ts 之后:boot.ts 要把右下角折叠坞一并 inert,
         而且 motion.ts 会监听它派发的 boot:done 才开始滚动入场 */
      import '../scripts/boot.ts';
      /* liquid-glass 挂载闸门:低配 / 减弱透明度 / 老浏览器直接跳过(见 glass.ts) */
      import '../scripts/glass.ts';
      /* 页脚的渲染档位开关(低配 / 高配) */
      import '../scripts/mode.ts';
    </script>
  </body>
</html>
